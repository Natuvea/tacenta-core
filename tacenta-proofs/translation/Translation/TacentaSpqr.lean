  let (rk, k1, k2) ← kdf_init sk
  let (cks, ckr) ←
    match direction with
    | Direction.A2b => ok (k1, k2)
    | Direction.B2a => ok (k2, k1)
  let y ←
    lift (Std.Array.to_slice
      (Array.make 1#usize [
         (0#u64,
         {
           send := (some { ck := cks, n := 0#u64 }),
           receive := (some { ck := ckr, n := 0#u64 })
         })
         ] : Array (Std.U64 × Chains) 1#usize))
  let ret := alloc.slice.Slice.into_vec y
  ok
    {
      rk,
      epoch := 0#u64,
      chains := ret,
      skipped := (alloc.vec.Vec.new Skipped),
      direction
    }

