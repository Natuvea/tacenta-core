/-- [tacenta_session::decode_ec]:
    Source: 'session/src/lib.rs', lines 209:0-228:1
    Visibility: public -/
def decode_ec
  (bytes : Slice Std.U8) : Result (Option (Array Std.U8 32#usize)) := do
  let i := Slice.len bytes
  if i = ENCODE_EC_LEN
  then
    let i1 ← Slice.index_usize bytes 0#usize
    if i1 = ENCODE_EC_CURVE25519
    then
      let k := Array.repeat 32#usize 0#u8
      let k1 ← decode_ec_loop bytes k 0#usize
      let b ← is_canonical_x25519 k1
      if b
      then ok (some k1)
      else ok none
    else ok none
  else ok none

