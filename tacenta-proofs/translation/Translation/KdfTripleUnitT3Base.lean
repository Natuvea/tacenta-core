/-!
# T3 base: how a translated value is read as a model value

- A byte (`U8`) is a Lean `UInt8` (`toM`).
- A byte array, slice or vector is the list of its bytes (`bytesOf`,
  `sliceBytes`, `vecBytes`).
- A 32-bit word (`U32`) is a Lean `UInt32` with the same bits (`toW`), and a
  word array is the list of its words (`wordsOf`).
-/

open Aeneas Aeneas.Std Result
namespace Tacenta.KdfProofTripleUnit
open tacenta_triple_unit.tacenta_kdf KdfStandardModel

/-- A translated byte, as a Lean `UInt8`. -/
def toM (x : U8) : UInt8 := UInt8.ofNat x.val

/-- The bytes of a translated array. -/
def bytesOf {n : Usize} (a : Array U8 n) : Bytes := a.val.map toM

/-- The bytes of a translated slice. -/
def sliceBytes (s : Slice U8) : Bytes := s.val.map toM

/-- The bytes of a translated vector. -/
def vecBytes (v : alloc.vec.Vec U8) : Bytes := v.val.map toM

/-- A translated 32-bit word as a Lean `UInt32`: the same bit vector. -/
def toW (x : U32) : UInt32 := UInt32.ofBitVec x.bv

/-- The words of a translated word array. -/
def wordsOf {n : Usize} (a : Array U32 n) : List UInt32 := a.val.map toW

/-- The streaming state after absorbing `m`: the compression function folded
over `m`'s whole 64-byte blocks, the rest in the buffer, and the byte count
mod 2^64. The named auxiliary specification of the streaming proof. -/
def Absorbed (s : sha256.Sha256) (m : Bytes) : Prop :=
  s.buf_len.val = m.length % 64 ∧
  s.total.val = m.length % 2 ^ 64 ∧
  wordsOf s.state = (Sha256.parse (m.take (64 * (m.length / 64)))).foldl Sha256.compress Sha256.H0 ∧
  (bytesOf s.buf).take (m.length % 64) = m.drop (64 * (m.length / 64))

/-- An HMAC state after `new key` and `update`s with `msg`: the inner hash
has absorbed `(K0 ⊕ ipad) ‖ msg`, and the outer block is `K0 ⊕ opad`
(FIPS 198-1 §4 steps 4–7). -/
def HmacState (m : hmac.HmacSha256) (key msg : Bytes) : Prop :=
  Absorbed m.inner (xorBytes (Hmac.K0 key) Hmac.ipad ++ msg) ∧
  bytesOf m.outer_block = xorBytes (Hmac.K0 key) Hmac.opad

end Tacenta.KdfProofTripleUnit
