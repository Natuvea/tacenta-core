def tacenta_triple.State.from_bytes
  (bytes : Slice Std.U8) :
  Result (core.result.Result tacenta_triple.State
    tacenta_triple.TripleDecodeError)
  := do
  let b ← core.slice.Slice.is_empty bytes
  if b
  then ok (core.result.Result.Err tacenta_triple.TripleDecodeError.TooShort)
  else
    let i ← Slice.index_usize bytes 0#usize
    if i != tacenta_triple.STATE_VERSION
    then
      ok (core.result.Result.Err
        tacenta_triple.TripleDecodeError.UnknownVersion)
    else
      let o ← tacenta_triple.take_len_prefixed bytes 1#usize
      match o with
      | none =>
        ok (core.result.Result.Err tacenta_triple.TripleDecodeError.TooShort)
      | some p =>
        let (classical_bytes, pos) := p
        let r ← tacenta_ratchet.State.from_bytes classical_bytes
        match r with
        | core.result.Result.Ok classical =>
          let o1 ← tacenta_triple.take_len_prefixed bytes pos
          match o1 with
          | none =>
            ok (core.result.Result.Err
              tacenta_triple.TripleDecodeError.TooShort)
          | some p1 =>
            let (pq_bytes, pos1) := p1
            let r1 ← tacenta_spqr.State.from_bytes pq_bytes
            match r1 with
            | core.result.Result.Ok post_quantum =>
              let i1 := Slice.len bytes
              if pos1 != i1
              then
                ok (core.result.Result.Err
                  tacenta_triple.TripleDecodeError.Malformed)
              else
                let b1 ←
                  tacenta_triple.State.invariant { classical, post_quantum }
                if b1
                then ok (core.result.Result.Ok { classical, post_quantum })
                else
                  ok (core.result.Result.Err
                    tacenta_triple.TripleDecodeError.Malformed)
            | core.result.Result.Err _ =>
              ok (core.result.Result.Err
                tacenta_triple.TripleDecodeError.Malformed)
        | core.result.Result.Err _ =>
          ok (core.result.Result.Err
            tacenta_triple.TripleDecodeError.Malformed)

