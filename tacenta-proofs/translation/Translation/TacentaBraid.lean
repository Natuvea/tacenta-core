def Braid.from_bytes
  (bytes : Slice Std.U8) :
  Result (core.result.Result Braid BraidDecodeError)
  := do
  let i := Slice.len bytes
  if i < 2#usize
  then ok (core.result.Result.Err BraidDecodeError.TooShort)
  else
    let i1 ← Slice.index_usize bytes 0#usize
    if i1 != STATE_VERSION
    then ok (core.result.Result.Err BraidDecodeError.UnknownVersion)
