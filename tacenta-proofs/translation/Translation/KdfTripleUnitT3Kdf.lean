/-- RFC 5869 §2.3's `T(n)`, by recursion on `n`: `T(0)` is empty and
`T(n+1) = HMAC(PRK, T(n) ‖ info ‖ (n+1))`, the counter as one octet. -/
def hkdfT (prk info : Bytes) : Nat → Bytes
  | 0 => []
  | n + 1 => hmac prk (hkdfT prk info n ++ info ++ [(n + 1).toUInt8])

theorem hkdfT_length (prk info : Bytes) (n : Nat) (hn : 1 ≤ n) :
    (hkdfT prk info n).length = 32 := by
  cases n with
  | zero => omega
  | succ n => exact hmac_length _ _

theorem expandBlocks_snoc_aux (prk info : Bytes) (k n : Nat) :
    Hkdf.expandBlocks prk info (hkdfT prk info k) (k + 1) (n + 1) =
      Hkdf.expandBlocks prk info (hkdfT prk info k) (k + 1) n ++ hkdfT prk info (k + n + 1) := by
  induction n generalizing k with
  | zero => simp [Hkdf.expandBlocks, hkdfT]
  | succ n ih =>
    have := ih (k + 1)
    rw [show k + 1 + n + 1 = k + (n + 1) + 1 by omega] at this
    conv_lhs => unfold Hkdf.expandBlocks
    conv_rhs => unfold Hkdf.expandBlocks
    simp only []
    rw [show hmac prk (hkdfT prk info k ++ info ++ [(k + 1).toUInt8]) = hkdfT prk info (k + 1) from rfl,
      this, List.append_assoc]

/-- `T(1) ‖ … ‖ T(n+1)` is `T(1) ‖ … ‖ T(n)` followed by `T(n+1)`. -/
theorem expandBlocks_snoc (prk info : Bytes) (n : Nat) :
    Hkdf.expandBlocks prk info [] 1 (n + 1) =
      Hkdf.expandBlocks prk info [] 1 n ++ hkdfT prk info (n + 1) := by
  have := expandBlocks_snoc_aux prk info 0 n
  simp only [Nat.zero_add] at this
  exact this

