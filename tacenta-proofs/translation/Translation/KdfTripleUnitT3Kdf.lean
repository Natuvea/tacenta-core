        have hj : j.val < 32 := by scalar_tac
        refine ⟨?_, by scalar_tac, by scalar_tac, by scalar_tac, ?_, by scalar_tac⟩
        · simp_all only [Slice.set_length]
        · rw [s_post, Slice.set_val_eq, h5, i1_post, pos1_post, j1_post]
          have ht : t.val.length = 32 := by simp
          have hol : out.val.length = out.length := rfl
          rw [set_append_drop (out.val.take pos.val ++ t.val.take j.val) out.val q.val _
            (by simp only [List.length_append, List.length_take]; omega) hq]
          rw [List.take_add_one, List.getElem?_eq_getElem (by simp; omega)]
          simp only [Option.toList_some, List.append_assoc, List.singleton_append]
      · simp only [WP.spec_ok]
        refine ⟨h1, by scalar_tac, ?_⟩
        rw [h5]; congr 3; omega
    · simp only [WP.spec_ok]
      refine ⟨h1, by scalar_tac, ?_⟩
      rw [h5]; congr 3; omega
  · exact ⟨rfl, by simp, by simp, hp, by simp⟩

/-- The optional `T(i-1)` feed: the Rust skips it for `i = 1`, where the
model's `T(0)` is empty. -/
theorem expand_prev_spec (m : hmac.HmacSha256) (prk info : Bytes) (t : Array U8 32#usize)
    (i : U8) (hi : 1 ≤ i.val) (hm : HmacState m prk [])
    (ht : 1 < i.val → bytesOf t = hkdfT prk info (i.val - 1)) :
    (if i > 1#u8 then do
        let s1 ← lift (Array.to_slice t)
        hmac.HmacSha256.update m s1
      else ok m) ⦃ m1 => HmacState m1 prk (hkdfT prk info (i.val - 1)) ⦄ := by
  split
  · rename_i h
    have h' : 1 < i.val := by scalar_tac
    step
    step with hmac_update_spec as ⟨m', hm'⟩
    rw [s1_post, sliceBytes_to_slice, List.nil_append, ht h'] at hm'
    exact hm'
  · rename_i h
    have h' : i.val = 1 := by scalar_tac
    simp only [WP.spec_ok, h']
    exact hm

/-- The counter octet: `Array.make 1 [i]` is the one byte `i`. -/
theorem sliceBytes_counter (i : U8) :
    sliceBytes (Array.to_slice (Array.make 1#usize [i])) = [(i.val).toUInt8] := rfl

/-- The bytes after one outer iteration: the blocks so far, then the part of
`T(i)` that fits, then the untouched rest of the original output. -/
theorem expand_out_bytes (o out out1 : Slice U8) (t1 : Array U8 32#usize) (pos pos1 : Nat)
    (E : Bytes) (hE : E.length = pos) (hp1 : pos ≤ pos1)
    (hc : sliceBytes o = E ++ (sliceBytes out).drop pos)
    (h3 : out1.val = o.val.take pos ++ t1.val.take (pos1 - pos) ++ o.val.drop pos1) :
    sliceBytes out1 = E ++ (bytesOf t1).take (pos1 - pos) ++ (sliceBytes out).drop pos1 := by
  have : sliceBytes out1 = (sliceBytes o).take pos ++
      (bytesOf t1).take (pos1 - pos) ++ (sliceBytes o).drop pos1 := by
    simp only [sliceBytes, bytesOf, h3, List.map_append, List.map_take, List.map_drop]
  rw [this, hc, List.take_left' hE, List.drop_append,
    List.drop_eq_nil_of_le (by omega), List.nil_append, hE, List.drop_drop]
  congr 3; omega

/-- The outer loop's invariant. Either `pos = 32·(i−1) < L` and `out` holds
`T(1) ‖ … ‖ T(i−1)` then its original bytes, with `t = T(i−1)` when `i > 1`;
or `pos = L` and `out` holds the whole of HKDF-Expand's output. -/
def ExpandInv (prk info : Bytes) (out : Slice U8)
    (p : Slice U8 × Array U8 32#usize × Usize × U8) : Prop :=
  p.1.length = out.length ∧ 1 ≤ p.2.2.2.val ∧
  ((p.2.2.1.val = 32 * (p.2.2.2.val - 1) ∧ p.2.2.1.val < out.length ∧
     sliceBytes p.1 = Hkdf.expandBlocks prk info [] 1 (p.2.2.2.val - 1) ++
       (sliceBytes out).drop p.2.2.1.val ∧
     (1 < p.2.2.2.val → bytesOf p.2.1 = hkdfT prk info (p.2.2.2.val - 1)))
   ∨ (p.2.2.1.val = out.length ∧ sliceBytes p.1 = Hkdf.expand prk info out.length))

theorem expand_loop_spec (prk : Array U8 32#usize) (info out : Slice U8)
    (t : Array U8 32#usize) (pos : Usize) (i : U8) (hL : out.length ≤ 8160)
    (hinv : ExpandInv (bytesOf prk) (sliceBytes info) out (out, t, pos, i)) :
    hkdf.expand_loop0 prk info out t pos i ⦃ r =>
      sliceBytes r = Hkdf.expand (bytesOf prk) (sliceBytes info) out.length ⦄ := by
  unfold hkdf.expand_loop0
  apply loop.spec_decr_nat (measure := fun p => out.length - p.2.2.1.val)
    (inv := ExpandInv (bytesOf prk) (sliceBytes info) out)
  · rintro ⟨o, t, pos, i⟩ ⟨h1, h2, h3⟩
    dsimp only at h1 h2 h3
    unfold hkdf.expand_loop0.body
    simp only []
    split
    · rcases h3 with ⟨ha, hb, hc, hd⟩ | ⟨hb, _⟩
      · step
        step with hmac_new_spec
        rw [s_post, sliceBytes_to_slice] at m_post
        step with expand_prev_spec m (bytesOf prk) (sliceBytes info) t i h2 m_post hd
        step with hmac_update_spec
        step
        step with hmac_update_spec
        step with hmac_finalize_spec
        step with expand_inner_spec
        -- name the counter: i = n + 1
        obtain ⟨n, hn⟩ : ∃ n, i.val = n + 1 := ⟨i.val - 1, by omega⟩
        have hn1 : i.val - 1 = n := by omega
        rw [hn1] at hc m1_post t1_post
        have hT : bytesOf t1 = hkdfT (bytesOf prk) (sliceBytes info) (n + 1) := by
          rw [t1_post, s1_post, sliceBytes_counter, hn]; rfl
        have hTl : (bytesOf t1).length = 32 := by rw [hT]; exact hkdfT_length _ _ _ (by omega)
        have hE : (Hkdf.expandBlocks (bytesOf prk) (sliceBytes info) [] 1 n).length = pos.val := by
          rw [Hkdf.expandBlocks_length]; omega
        have hol : (sliceBytes out).length = out.length := sliceBytes_length out
        have hp1 : pos.val ≤ pos1.val := by scalar_tac
        split
        · have hlt1 : pos1.val < out.length := by scalar_tac
          have hpos1 : pos1.val = pos.val + 32 := by omega
          step
          have hi3 : i3.val - 1 = n + 1 := by omega
          dsimp only [ExpandInv]
          refine ⟨⟨by omega, by omega, Or.inl ⟨by omega, by omega, ?_, ?_⟩⟩, by omega⟩
          · rw [hi3, expandBlocks_snoc,
              expand_out_bytes o out out1 t1 _ _ _ hE hp1 hc out1_post3, hpos1,
              Nat.add_sub_cancel_left, List.take_of_length_le (l := bytesOf t1) (by omega), hT]
          · intro _
            rw [hi3, hT]
        · simp only [WP.spec_ok]
          have hge : out.length ≤ pos1.val := by scalar_tac
          have hpos1 : pos1.val = out.length := by omega
          have hlt : out.length - pos.val ≤ 32 := by omega
          dsimp only [ExpandInv]
          refine ⟨⟨by omega, h2, Or.inr ⟨hpos1, ?_⟩⟩, by omega⟩
          have hN : (out.length + Hkdf.HashLen - 1) / Hkdf.HashLen = n + 1 := by
            simp only [Hkdf.HashLen]; omega
          rw [expand_out_bytes o out out1 t1 _ _ _ hE hp1 hc out1_post3, Hkdf.expand, hN,
            expandBlocks_snoc, hpos1, List.take_append, hE,
            List.take_of_length_le (l := Hkdf.expandBlocks _ _ _ _ _) (by omega), ← hT,
            List.drop_of_length_le (l := sliceBytes out) (by omega), List.append_nil]
      · exfalso; scalar_tac
    · rcases h3 with ⟨ha, hb, hc, hd⟩ | ⟨hb, hc⟩
      · exfalso; scalar_tac
      · simp only [WP.spec_ok]; exact hc
  · exact hinv

@[step]
theorem expand_spec (prk : Array U8 32#usize) (info out : Slice U8) (hL : out.length ≤ 8160) :
    hkdf.expand prk info out ⦃ r =>
      sliceBytes r = Hkdf.expand (bytesOf prk) (sliceBytes info) out.length ⦄ := by
  unfold hkdf.expand
  apply expand_loop_spec _ _ _ _ _ _ hL
  refine ⟨rfl, by simp, ?_⟩
  dsimp only
  by_cases h0 : out.length = 0
  · right
    refine ⟨by rw [h0]; rfl, ?_⟩
    have h1 : sliceBytes out = [] := by
      rw [← List.length_eq_zero_iff, sliceBytes_length, h0]
    have h2 : Hkdf.expand (bytesOf prk) (sliceBytes info) out.length = [] := by
      rw [← List.length_eq_zero_iff, Hkdf.expand_length, h0]
    rw [h1, h2]
  · left
    have h00 : (0#usize).val = 0 := by simp
    refine ⟨by simp, by rw [h00]; omega, ?_, ?_⟩
    · rfl
    · intro h; exact absurd h (by decide)

/-- **T3 for `hkdf_sha256_into`.** -/
@[step]
theorem hkdf_sha256_into_spec (salt ikm info out : Slice U8) (hL : out.length ≤ 8160) :
    tacenta_triple_unit.tacenta_kdf.hkdf.hkdf_sha256_into salt ikm info out ⦃ r =>
      sliceBytes r = KdfStandardModel.hkdf (sliceBytes salt) (sliceBytes ikm) (sliceBytes info) out.length ⦄ := by
  unfold hkdf.hkdf_sha256_into hkdf.MAX_OUTPUT_LEN
  simp only [hkdf.HASH_LEN]
  step
  step
  step with extract_spec
  step with expand_spec
  rw [r_post, prk_post]; rfl

/-- **T3 for `hkdf_sha256::<N>`.** -/
@[step]
theorem hkdf_sha256_spec (N : Usize) (salt ikm info : Slice U8) (hN : N.val ≤ 8160) :
    tacenta_triple_unit.tacenta_kdf.hkdf.hkdf_sha256 N salt ikm info ⦃ r =>
      bytesOf r = KdfStandardModel.hkdf (sliceBytes salt) (sliceBytes ikm) (sliceBytes info) N.val ⦄ := by
  unfold hkdf.hkdf_sha256
  step
  step with hkdf_sha256_into_spec
  have hr : r.length = N.val := by
    simp only [Slice.length, r_post1, Array.repeat_val, List.length_replicate]
  rw [hr] at s1_post
  have hs1 : s1.val.length = N.val := by
    rw [← hkdf_length (sliceBytes salt) (sliceBytes ikm) (sliceBytes info) N.val, ← s1_post]
    simp [sliceBytes]
  rw [r_post2]
  show (Array.from_slice _ s1).val.map toM = _
  rw [Array.from_slice_val _ _ hs1]
  exact s1_post

end Tacenta.KdfProofTripleUnit