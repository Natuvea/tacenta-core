/-- [tacenta_triple::take_len_prefixed]:
    Source: 'triple/src/lib.rs', lines 392:0-414:1 -/
def take_len_prefixed
  (bytes : Slice Std.U8) (pos : Std.Usize) :
  Result (Option ((Slice Std.U8) × Std.Usize))
  := do
  let o ← lift (Usize.checked_add pos 4#usize)
  match o with
  | none => ok none
  | some s =>
    let i := Slice.len bytes
    if i < s
    then ok none
    else
      let len_bytes := Array.repeat 4#usize 0#u8
      let (s1, to_slice_mut_back) ← lift (Array.to_slice_mut len_bytes)
      let s2 ←
        core.slice.index.Slice.index
          (core.slice.index.SliceIndexRangeUsizeSlice Std.U8) bytes
          { start := pos, «end» := s }
      let s3 ← core.slice.Slice.copy_from_slice core.marker.CopyU8 s1 s2
      let len_bytes1 := to_slice_mut_back s3
      let i1 ← lift (core.num.U32.from_be_bytes len_bytes1)
      let len ← lift (UScalar.cast .Usize i1)
      let o1 ← lift (Usize.checked_add s len)
      match o1 with
      | none => ok none
      | some e =>
        let i2 := Slice.len bytes
        if i2 < e
        then ok none
        else
          let s4 ←
            core.slice.index.Slice.index
              (core.slice.index.SliceIndexRangeUsizeSlice Std.U8) bytes
              { start := s, «end» := e }
          ok (some (s4, e))

/-- [tacenta_triple::{tacenta_triple::State}::to_bytes]:
    Source: 'triple/src/lib.rs', lines 423:4-433:5
    Visibility: public -/
def State.to_bytes
  (self : State) : Result (zeroize.Zeroizing (alloc.vec.Vec Std.U8)) := do
  let out ← alloc.vec.Vec.push (alloc.vec.Vec.new Std.U8) STATE_VERSION
  let classical ← tacenta_ratchet.State.to_bytes self.classical
  let v ←
    zeroize.Zeroizing.Insts.CoreOpsDerefDeref.deref
      (alloc.vec.Vec.Insts.ZeroizeZeroize (zeroize.Zeroize.Blanket
      U8.Insts.ZeroizeDefaultIsZeroes)) classical
  let i := alloc.vec.Vec.len v
  let i1 ← lift (UScalar.cast .U32 i)
  let a ← lift (core.num.U32.to_be_bytes i1)
  let s ← lift (Array.to_slice a)
  let out1 ← alloc.vec.Vec.extend_from_slice core.clone.CloneU8 out s
  let s1 := alloc.vec.Vec.deref v
  let out2 ← alloc.vec.Vec.extend_from_slice core.clone.CloneU8 out1 s1
  let post_quantum ← tacenta_spqr.State.to_bytes self.post_quantum
  let v1 ←
    zeroize.Zeroizing.Insts.CoreOpsDerefDeref.deref
      (alloc.vec.Vec.Insts.ZeroizeZeroize (zeroize.Zeroize.Blanket
      U8.Insts.ZeroizeDefaultIsZeroes)) post_quantum
  let i2 := alloc.vec.Vec.len v1
  let i3 ← lift (UScalar.cast .U32 i2)
  let a1 ← lift (core.num.U32.to_be_bytes i3)
  let s2 ← lift (Array.to_slice a1)
  let out3 ← alloc.vec.Vec.extend_from_slice core.clone.CloneU8 out2 s2
  let s3 := alloc.vec.Vec.deref v1
  let out4 ← alloc.vec.Vec.extend_from_slice core.clone.CloneU8 out3 s3
  zeroize.Zeroizing.new (alloc.vec.Vec.Insts.ZeroizeZeroize
    (zeroize.Zeroize.Blanket U8.Insts.ZeroizeDefaultIsZeroes)) out4

/-- [tacenta_triple::{tacenta_triple::State}::from_bytes]:
    Source: 'triple/src/lib.rs', lines 436:4-462:5
    Visibility: public -/
def State.from_bytes
  (bytes : Slice Std.U8) :
  Result (core.result.Result State TripleDecodeError)
  := do
  let b ← core.slice.Slice.is_empty bytes
  if b
  then ok (core.result.Result.Err TripleDecodeError.TooShort)
  else
    let i ← Slice.index_usize bytes 0#usize
    if i != STATE_VERSION
    then ok (core.result.Result.Err TripleDecodeError.UnknownVersion)
    else
      let o ← take_len_prefixed bytes 1#usize
      match o with
      | none => ok (core.result.Result.Err TripleDecodeError.TooShort)
      | some p =>
        let (classical_bytes, pos) := p
        let r ← tacenta_ratchet.State.from_bytes classical_bytes
        match r with
        | core.result.Result.Ok classical =>
          let o1 ← take_len_prefixed bytes pos
          match o1 with
          | none => ok (core.result.Result.Err TripleDecodeError.TooShort)
          | some p1 =>
            let (pq_bytes, pos1) := p1
            let r1 ← tacenta_spqr.State.from_bytes pq_bytes
            match r1 with
            | core.result.Result.Ok post_quantum =>
              let i1 := Slice.len bytes
              if pos1 != i1
              then ok (core.result.Result.Err TripleDecodeError.Malformed)
              else ok (core.result.Result.Ok { classical, post_quantum })
            | core.result.Result.Err _ =>
              ok (core.result.Result.Err TripleDecodeError.Malformed)
        | core.result.Result.Err _ =>
          ok (core.result.Result.Err TripleDecodeError.Malformed)

