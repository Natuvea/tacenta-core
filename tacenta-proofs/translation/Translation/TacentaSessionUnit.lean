/-- [tacenta_session_unit::lifecycle::full_store]:
    Source: 'session-unit/src/lifecycle.rs', lines 332:0-338:1 -/
def lifecycle.full_store
  (e : tacenta_triple.TripleError) : Result (Option lifecycle.FullStore) := do
  match e with
  | tacenta_triple.TripleError.Classical re =>
    match re with
    | tacenta_ratchet.RatchetError.TooManySkipped => ok none
    | tacenta_ratchet.RatchetError.SkippedStoreFull =>
      ok (some lifecycle.FullStore.Classical)
    | tacenta_ratchet.RatchetError.NoSendingChain => ok none
    | tacenta_ratchet.RatchetError.NoReceivingChain => ok none
    | tacenta_ratchet.RatchetError.OutOfOrder => ok none
    | tacenta_ratchet.RatchetError.ChainExhausted => ok none
  | tacenta_triple.TripleError.PostQuantum se =>
    match se with
    | tacenta_spqr.SpqrError.EpochOutOfOrder => ok none
    | tacenta_spqr.SpqrError.NoChain => ok none
    | tacenta_spqr.SpqrError.ChainRetired => ok none
    | tacenta_spqr.SpqrError.TooManySkipped => ok none
    | tacenta_spqr.SpqrError.SkippedStoreFull =>
      ok (some lifecycle.FullStore.PostQuantum)
    | tacenta_spqr.SpqrError.OutOfOrder => ok none
    | tacenta_spqr.SpqrError.ChainExhausted => ok none

