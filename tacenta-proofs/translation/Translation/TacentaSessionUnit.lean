/-- [tacenta_session_unit::lifecycle::receive_shortfall]:
    Source: 'session-unit/src/lifecycle.rs', lines 340:0-368:1 -/
def lifecycle.receive_shortfall
  (half : lifecycle.FullStore) (state : tacenta_triple.State)
  (composite : tacenta_wire.Composite) :
  Result Std.Usize
  := do
  match half with
  | lifecycle.FullStore.Classical =>
    let held ← tacenta_triple.State.classical_skipped_len state
    let i ← lift (UScalar.cast .Usize composite.n)
    let i1 ← tacenta_triple.State.receive_count state
    let i2 ← lift (UScalar.cast .Usize i1)
    let need ← lift (core.num.Usize.saturating_sub i i2)
    let i3 ← lift (core.num.Usize.saturating_add held need)
    let shortfall ←
      lift (core.num.Usize.saturating_sub i3 tacenta_ratchet.MAX_SKIPPED_STORE)
    if shortfall < 1#usize
    then ok 1#usize
    else ok shortfall
  | lifecycle.FullStore.PostQuantum =>
    let o ←
      tacenta_triple.State.post_quantum_receive_count state composite.pq_epoch
    match o with
    | none => ok 1#usize
    | some received =>
      let held ← tacenta_triple.State.post_quantum_skipped_len state
      let i ← lift (core.num.U64.saturating_sub composite.pq_n 1#u64)
      let i1 ← lift (core.num.U64.saturating_sub i received)
      let need ← lifecycle.saturating_usize_from_u64 i1
      let i2 ← lift (core.num.Usize.saturating_add held need)
      let shortfall ←
        lift (core.num.Usize.saturating_sub i2 tacenta_spqr.MAX_SKIPPED_STORE)
      if shortfall < 1#usize
      then ok 1#usize
      else ok shortfall

