def serialization.encode_initial
  (identity : Slice Std.U8) (ephemeral : Slice Std.U8)
  (kem_ciphertext : Slice Std.U8) (signed_prekey_id : Std.U32)
  (one_time_prekey_id : Std.U32) (kem_prekey_id : Std.U32)
  (message : Slice Std.U8) :
  Result (alloc.vec.Vec Std.U8)
  := do
  let out ←
    alloc.vec.Vec.push (alloc.vec.Vec.new Std.U8) tacenta_wire.VERSION
  let out1 ← alloc.vec.Vec.push out tacenta_wire.TYPE_INITIAL
  let out2 ← alloc.vec.Vec.extend_from_slice core.clone.CloneU8 out1 identity
  let out3 ←
    alloc.vec.Vec.extend_from_slice core.clone.CloneU8 out2 ephemeral
  let i := Slice.len kem_ciphertext
  let i1 ← lift (UScalar.cast .U32 i)
  let a ← lift (core.num.U32.to_be_bytes i1)
  let s ← lift (Array.to_slice a)
  let out4 ← alloc.vec.Vec.extend_from_slice core.clone.CloneU8 out3 s
  let out5 ←
    alloc.vec.Vec.extend_from_slice core.clone.CloneU8 out4 kem_ciphertext
  let a1 ← lift (core.num.U32.to_be_bytes signed_prekey_id)
  let s1 ← lift (Array.to_slice a1)
  let out6 ← alloc.vec.Vec.extend_from_slice core.clone.CloneU8 out5 s1
  let a2 ← lift (core.num.U32.to_be_bytes one_time_prekey_id)
  let s2 ← lift (Array.to_slice a2)
  let out7 ← alloc.vec.Vec.extend_from_slice core.clone.CloneU8 out6 s2
  let a3 ← lift (core.num.U32.to_be_bytes kem_prekey_id)
  let s3 ← lift (Array.to_slice a3)
  let out8 ← alloc.vec.Vec.extend_from_slice core.clone.CloneU8 out7 s3
  alloc.vec.Vec.extend_from_slice core.clone.CloneU8 out8 message

