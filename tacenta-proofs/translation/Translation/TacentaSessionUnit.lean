                      lifecycle.identity_ad pkb1
                        their_bundle.bundle.identity_key
                    let pkb2 ←
                      tacenta_boundary.dh.PrivateKey.public_key ephemeral
                    ok (core.result.Result.Ok
                      {
                        triple,
                        braid,
                        ratchet_private,
                        identity_ad := v,
                        our_identity_public := pkb1,
                        peer_identity_public :=
                          their_bundle.bundle.identity_key,
                        pending_initial :=
                          (some
                            {
                              ephemeral_public := pkb2,
                              kem_ciphertext,
                              signed_prekey_id := their_bundle.signed_prekey_id,
                              one_time_prekey_id :=
                                their_bundle.one_time_prekey_id,
                              kem_prekey_id := their_bundle.kem_prekey_id
