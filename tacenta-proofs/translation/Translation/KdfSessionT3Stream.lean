theorem bytesOf_set_getElem? {n : Usize} (a : Array U8 n) (i : Usize) (v : U8) (j : Nat) :
    (bytesOf (a.set i v))[j]? = if i.val = j ∧ j < n.val then some (toM v) else (bytesOf a)[j]? := by
  simp only [bytesOf, Std.Array.set_val_eq, List.getElem?_map, List.getElem?_set]
  split_ifs <;> simp_all

theorem toM_eq_of_val (y : U8) (b : UInt8) (h : y.val = b.toNat) : toM y = b := by
  unfold toM
  apply UInt8.toNat_inj.mp
  rw [UInt8.toNat_ofNat', h]
  exact Nat.mod_eq_of_lt b.toNat_lt

theorem cast_u8_val {ty : UScalarTy} (x : UScalar ty) : (UScalar.cast .U8 x).val = x.val % 256 := by
  simp [UScalar.cast_val_eq]

theorem toM_zero : toM 0#u8 = 0 := rfl

/-- Byte `k` (from 0, most significant first) of `be64 X`. -/
def lenByte (X k : Nat) : UInt8 := (X / 256 ^ (7 - k) % 256).toUInt8

theorem be64_getElem? (X k : Nat) (hk : k < 8) : (Sha256.be64 X)[k]? = some (lenByte X k) := by
  unfold Sha256.be64 lenByte
  obtain rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl :
    k = 0 ∨ k = 1 ∨ k = 2 ∨ k = 3 ∨ k = 4 ∨ k = 5 ∨ k = 6 ∨ k = 7 := by omega
  all_goals rfl

theorem flatMap_wordBytes_getElem? (L : List UInt32) (w b : Nat) (hb : b < 4) :
    (L.flatMap Sha256.wordBytes)[4 * w + b]? = L[w]?.bind (fun x => (Sha256.wordBytes x)[b]?) := by
  induction L generalizing w with
  | nil => simp
  | cons x L ih =>
    rw [List.flatMap_cons]
    have hl : (Sha256.wordBytes x).length = 4 := rfl
    cases w with
    | zero => rw [List.getElem?_append_left (by omega)]; simp
    | succ w =>
      rw [List.getElem?_append_right (by omega), hl, show 4 * (w + 1) + b - 4 = 4 * w + b by omega,
        ih]
      simp

theorem wordByte_eq (x y : U32) (k : UInt32) (hk : k.toNat < 32) (hy : y.val = x.val >>> k.toNat) :
    toM (UScalar.cast .U8 y) = (toW x >>> k).toUInt8 := by
  apply toM_eq_of_val
  rw [cast_u8_val, hy, UInt32.toNat_toUInt8, UInt32.toNat_shiftRight, Nat.mod_eq_of_lt hk]
  rfl

theorem wordByte_eq0 (x : U32) : toM (UScalar.cast .U8 x) = (toW x).toUInt8 := by
  apply toM_eq_of_val
  rw [cast_u8_val, UInt32.toNat_toUInt8]
  rfl

