    refine ⟨?_, ?_, ?_, ?_⟩
    · simp only [List.length_append, List.length_singleton]; rw [hL]; rfl
    · rw [List.length_append, List.length_singleton]; exact htv
    · have ht : (m ++ [toM b]).take (64 * ((m ++ [toM b]).length / 64)) =
          m.take (64 * (m.length / 64)) ++ (m.drop (64 * (m.length / 64)) ++ [toM b]) := by
        rw [List.take_of_length_le (by simp; omega), ← List.append_assoc, List.take_append_drop]
      rw [ht, parse_append _ _ (take_blocks_length m), List.foldl_append, ← hfull,
        parse_block (bytesOf (back b)) (bytesOf_length _), ha1, h3]
