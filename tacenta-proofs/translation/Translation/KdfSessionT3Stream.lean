  · simp; omega
  · intro j h1 h2
    simp only [List.length_take, List.length_set] at h1
    rw [List.getElem_take, List.getElem_set]
    by_cases hj : j < i
    · rw [if_neg (by omega), List.getElem_append_left (by simp; omega)]
      simp
    · have : j = i := by omega
      subst this
      rw [if_pos rfl, List.getElem_append_right (by simp)]
      simp

theorem bytesOf_set_take {n : Usize} (a : Array U8 n) (i : Usize) (v : U8) (hi : i.val < n.val) :
    (bytesOf (a.set i v)).take (i.val + 1) = (bytesOf a).take i.val ++ [toM v] := by
  simp only [bytesOf, Std.Array.set_val_eq, List.map_set]
  exact take_set_succ _ _ _ (by simp; omega)

