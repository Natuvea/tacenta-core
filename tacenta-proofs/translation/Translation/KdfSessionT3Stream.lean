    (hi : i.val ≤ data.length) (h : Absorbed s (m ++ (sliceBytes data).take i.val)) :
    sha256.Sha256.update_loop s data i ⦃ s' => Absorbed s' (m ++ sliceBytes data) ⦄ := by
  unfold sha256.Sha256.update_loop
  apply loop.spec_decr_nat
    (measure := fun p => data.length - p.2.val)
    (inv := fun p => p.2.val ≤ data.length ∧ Absorbed p.1 (m ++ (sliceBytes data).take p.2.val))
  · rintro ⟨s1, i1⟩ ⟨hi1, hs1⟩
    dsimp only at hi1 hs1
    unfold sha256.Sha256.update_loop.body
    simp only []
    split
    · rename_i hlt
      step as ⟨x, hx⟩
      step with absorb_spec s1 _ x hs1 as ⟨s2, hs2⟩
      step as ⟨i2, hi2⟩
      refine ⟨by scalar_tac, ?_, by scalar_tac⟩
      rw [hi2, sliceBytes_take_succ data i1.val (by scalar_tac), ← List.append_assoc]
      rw [hx] at hs2
      exact hs2
    · rename_i hge
      simp only [WP.spec_ok]
      have he : i1.val = data.length := by scalar_tac
      rw [he] at hs1
      rwa [List.take_of_length_le (by simp [sliceBytes])] at hs1
  · exact ⟨hi, h⟩

@[step]
theorem update_spec (s : sha256.Sha256) (m : Bytes) (data : Slice U8) (h : Absorbed s m) :
    sha256.Sha256.update s data ⦃ s' => Absorbed s' (m ++ sliceBytes data) ⦄ := by
  unfold sha256.Sha256.update
  exact update_loop_spec s m data 0#usize (by simp) (by simpa using h)

