/-! ## Pure-list model lemmas -/

theorem chunks_append (size c d : Nat) (x y : Bytes) (hx : x.length = size * c) :
    chunks size (c + d) (x ++ y) = chunks size c x ++ chunks size d y := by
  induction c generalizing x with
  | zero =>
    have : x = [] := List.eq_nil_of_length_eq_zero (by simpa using hx)
    subst this; simp [chunks]
  | succ c ih =>
    rw [Nat.add_right_comm]
    simp only [chunks]
    have h1 : (x ++ y).take size = x.take size := by
      rw [List.take_append_of_le_length (by rw [hx]; exact Nat.le_mul_of_pos_right _ (by omega))]
    have h2 : (x ++ y).drop size = x.drop size ++ y := by
      rw [List.drop_append_of_le_length (by rw [hx]; exact Nat.le_mul_of_pos_right _ (by omega))]
    rw [h1, h2, ih (x.drop size) (by simp [hx, Nat.mul_succ])]
    rfl

theorem parse_append (x y : Bytes) (hx : x.length % 64 = 0) :
    Sha256.parse (x ++ y) = Sha256.parse x ++ Sha256.parse y := by
  simp only [Sha256.parse, List.length_append]
  have : (x.length + y.length) / 64 = x.length / 64 + y.length / 64 := by omega
  rw [this, chunks_append 64 _ _ x y (by omega), List.map_append]

theorem parse_block (B : Bytes) (hB : B.length = 64) :
    Sha256.parse B = [Sha256.parseBlock B] := by
  simp only [Sha256.parse, hB]
  simp [chunks, List.take_of_length_le (le_of_eq hB)]

theorem padZero_short (L : Nat) (h : L % 64 ≤ 55) :
    (Sha256.padZeroBits (8 * L) - 7) / 8 = 55 - L % 64 := by
  unfold Sha256.padZeroBits; omega

theorem padZero_long (L : Nat) (h : 56 ≤ L % 64) :
    (Sha256.padZeroBits (8 * L) - 7) / 8 = 119 - L % 64 := by
  unfold Sha256.padZeroBits; omega

/-- `pad m` is the whole blocks of `m`, then the padded tail. -/
theorem pad_split (m : Bytes) :
    Sha256.pad m = m.take (64 * (m.length / 64)) ++
      (m.drop (64 * (m.length / 64)) ++ [0x80] ++
        List.replicate ((Sha256.padZeroBits (8 * m.length) - 7) / 8) 0 ++
        Sha256.be64 (8 * m.length % 2 ^ 64)) := by
  simp only [Sha256.pad, Sha256.lengthBlock, List.append_assoc]
  rw [← List.append_assoc (List.take _ m) (List.drop _ m), List.take_append_drop]

theorem take_blocks_length (m : Bytes) :
    (m.take (64 * (m.length / 64))).length % 64 = 0 := by
  simp only [List.length_take]; omega

theorem drop_blocks_length (m : Bytes) :
    (m.drop (64 * (m.length / 64))).length = m.length % 64 := by
  simp only [List.length_drop]; omega

/-- The model's hash when the tail fits one block (`|m| mod 64 ≤ 55`). -/
theorem hash_short (m : Bytes) (h : m.length % 64 ≤ 55) :
    KdfStandardModel.sha256 m =
      (Sha256.compress
        ((Sha256.parse (m.take (64 * (m.length / 64)))).foldl Sha256.compress Sha256.H0)
        (Sha256.parseBlock (m.drop (64 * (m.length / 64)) ++ [0x80] ++
          List.replicate (55 - m.length % 64) 0 ++ Sha256.be64 (8 * m.length % 2 ^ 64)))).flatMap
        Sha256.wordBytes := by
  simp only [KdfStandardModel.sha256, Sha256.hash]
  have hl : (m.drop (64 * (m.length / 64)) ++ [0x80] ++
      List.replicate (55 - m.length % 64) (0 : UInt8) ++
      Sha256.be64 (8 * m.length % 2 ^ 64)).length = 64 := by
    simp only [List.length_append, drop_blocks_length, List.length_replicate, List.length_cons,
      List.length_nil, Sha256.be64_length]
    omega
  rw [pad_split, parse_append _ _ (take_blocks_length m), List.foldl_append, padZero_short _ h,
    parse_block _ hl]
  rfl

/-- The model's hash when the tail needs two blocks (`|m| mod 64 ≥ 56`). -/
theorem hash_long (m : Bytes) (h : 56 ≤ m.length % 64) :
    KdfStandardModel.sha256 m =
      (Sha256.compress
        (Sha256.compress
          ((Sha256.parse (m.take (64 * (m.length / 64)))).foldl Sha256.compress Sha256.H0)
          (Sha256.parseBlock (m.drop (64 * (m.length / 64)) ++ [0x80] ++
            List.replicate (63 - m.length % 64) 0)))
        (Sha256.parseBlock (List.replicate 56 0 ++ Sha256.be64 (8 * m.length % 2 ^ 64)))).flatMap
        Sha256.wordBytes := by
  simp only [KdfStandardModel.sha256, Sha256.hash]
  have hr : 119 - m.length % 64 = (63 - m.length % 64) + 56 := by omega
  have hl1 : (m.drop (64 * (m.length / 64)) ++ [0x80] ++
      List.replicate (63 - m.length % 64) (0 : UInt8)).length = 64 := by
    simp only [List.length_append, drop_blocks_length, List.length_replicate, List.length_cons,
      List.length_nil]
    omega
  have hl2 : (List.replicate 56 (0 : UInt8) ++ Sha256.be64 (8 * m.length % 2 ^ 64)).length = 64 := by
    simp [Sha256.be64_length]
  rw [pad_split, parse_append _ _ (take_blocks_length m), List.foldl_append, padZero_long _ h, hr,
    List.replicate_add]
  have e : ∀ (a b c d f : Bytes), a ++ b ++ (c ++ d) ++ f = (a ++ b ++ c) ++ (d ++ f) := by
    intros; simp
  rw [e, parse_append _ _ (by rw [hl1]), parse_block _ hl1, parse_block _ hl2]
  rfl

