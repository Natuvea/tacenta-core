theorem sliceBytes_take_succ (data : Slice U8) (i : Nat) (hi : i < data.length) :
    (sliceBytes data).take (i + 1) = (sliceBytes data).take i ++ [toM data.val[i]] := by
  rw [List.take_add_one, List.getElem?_eq_getElem (by simp [sliceBytes]; scalar_tac)]
  simp [sliceBytes]

