      if 56 + j0.val ≤ k ∧ k < 56 + p.2.val then some (lenByte bit_len.val (k - 56))
      else (bytesOf buf)[k]?)
  · rintro ⟨b1, j1⟩ ⟨h1, h2, h3⟩
    dsimp only at h1 h2 h3
    unfold sha256.Sha256.finalize_loop2.body
    simp only []
    split
    · step as ⟨i, hi⟩
      step as ⟨i1, hi1⟩
      step as ⟨i2, hi2, hi2'⟩
      step as ⟨i3, hi3⟩
      step as ⟨i4, hi4⟩
      step as ⟨a, ha⟩
      step as ⟨j2, hj2⟩
      have hlt : j1.val < 8 := by scalar_tac
      have hbyte : toM i4 = lenByte bit_len.val j1.val := by
        apply toM_eq_of_val
        rw [hi4, cast_u8_val, hi2, hi1, hi, Nat.shiftRight_eq_div_pow]
        unfold lenByte
        have hp : (2 : Nat) ^ (56 - 8 * j1.val) = 256 ^ (7 - j1.val) := by
          rw [show (256 : Nat) = 2 ^ 8 by rfl, ← Nat.pow_mul]; congr 1; omega
        rw [hp, Nat.toUInt8, UInt8.toNat_ofNat']
        omega
      refine ⟨by omega, by scalar_tac, ?_, by scalar_tac⟩
      intro k
      rw [ha, bytesOf_set_getElem?, h3, hj2, hi3]
      by_cases hk : 56 + j1.val = k
      · rw [if_pos ⟨hk, by scalar_tac⟩, if_pos ⟨by omega, by omega⟩, hbyte,
          show k - 56 = j1.val by omega]
      · rw [if_neg (by omega)]
        by_cases hk2 : 56 + j0.val ≤ k ∧ k < 56 + j1.val
        · rw [if_pos hk2, if_pos ⟨hk2.1, by omega⟩]
        · rw [if_neg hk2, if_neg (by omega)]
    · simp only [WP.spec_ok]
      have he : j1.val = 8 := by scalar_tac
      rw [he] at h3; exact h3
  · refine ⟨le_refl _, hj0, ?_⟩
    dsimp only; intro k; rw [if_neg (by omega)]

theorem finalize_loop5_spec (bit_len : U64) (buf : Array U8 64#usize) (j0 : Usize)
    (hj0 : j0.val ≤ 8) :
    sha256.Sha256.finalize_loop5 bit_len buf j0 ⦃ r => ∀ k, (bytesOf r)[k]? =
      if 56 + j0.val ≤ k ∧ k < 64 then some (lenByte bit_len.val (k - 56))
      else (bytesOf buf)[k]? ⦄ := by
  unfold sha256.Sha256.finalize_loop5
  apply loop.spec_decr_nat (measure := fun p => 8 - p.2.val)
    (inv := fun p => j0.val ≤ p.2.val ∧ p.2.val ≤ 8 ∧ ∀ k, (bytesOf p.1)[k]? =
      if 56 + j0.val ≤ k ∧ k < 56 + p.2.val then some (lenByte bit_len.val (k - 56))
      else (bytesOf buf)[k]?)
  · rintro ⟨b1, j1⟩ ⟨h1, h2, h3⟩
    dsimp only at h1 h2 h3
    unfold sha256.Sha256.finalize_loop5.body
    simp only []
    split
    · step as ⟨i, hi⟩
      step as ⟨i1, hi1⟩
      step as ⟨i2, hi2, hi2'⟩
      step as ⟨i3, hi3⟩
      step as ⟨i4, hi4⟩
      step as ⟨a, ha⟩
      step as ⟨j2, hj2⟩
      have hlt : j1.val < 8 := by scalar_tac
      have hbyte : toM i4 = lenByte bit_len.val j1.val := by
        apply toM_eq_of_val
        rw [hi4, cast_u8_val, hi2, hi1, hi, Nat.shiftRight_eq_div_pow]
        unfold lenByte
        have hp : (2 : Nat) ^ (56 - 8 * j1.val) = 256 ^ (7 - j1.val) := by
          rw [show (256 : Nat) = 2 ^ 8 by rfl, ← Nat.pow_mul]; congr 1; omega
        rw [hp, Nat.toUInt8, UInt8.toNat_ofNat']
        omega
      refine ⟨by omega, by scalar_tac, ?_, by scalar_tac⟩
      intro k
      rw [ha, bytesOf_set_getElem?, h3, hj2, hi3]
      by_cases hk : 56 + j1.val = k
      · rw [if_pos ⟨hk, by scalar_tac⟩, if_pos ⟨by omega, by omega⟩, hbyte,
          show k - 56 = j1.val by omega]
      · rw [if_neg (by omega)]
        by_cases hk2 : 56 + j0.val ≤ k ∧ k < 56 + j1.val
        · rw [if_pos hk2, if_pos ⟨hk2.1, by omega⟩]
        · rw [if_neg hk2, if_neg (by omega)]
    · simp only [WP.spec_ok]
      have he : j1.val = 8 := by scalar_tac
      rw [he] at h3; exact h3
  · refine ⟨le_refl _, hj0, ?_⟩
    dsimp only; intro k; rw [if_neg (by omega)]

theorem finalize_loop3_spec (state : Array U32 8#usize) (out : Array U8 32#usize) (i : Usize)
    (hi : i.val ≤ 8)
    (hout : ∀ k < 4 * i.val, (bytesOf out)[k]? = ((wordsOf state).flatMap Sha256.wordBytes)[k]?) :
    sha256.Sha256.finalize_loop3 state out i ⦃ r =>
      bytesOf r = (wordsOf state).flatMap Sha256.wordBytes ⦄ := by
  unfold sha256.Sha256.finalize_loop3
  apply loop.spec_decr_nat (measure := fun p => 8 - p.2.val)
    (inv := fun p => p.2.val ≤ 8 ∧
      ∀ k < 4 * p.2.val, (bytesOf p.1)[k]? = ((wordsOf state).flatMap Sha256.wordBytes)[k]?)
  · rintro ⟨o1, ii⟩ ⟨h1, h2⟩
    dsimp only at h1 h2
    unfold sha256.Sha256.finalize_loop3.body
    simp only []
    split
    · step*
      refine ⟨by scalar_tac, ?_, by scalar_tac⟩
      intro k hk
      have hii : ii.val < state.val.length := by scalar_tac
      have hw : (wordsOf state)[ii.val]? = some (toW state.val[ii.val]) := by
        simp only [wordsOf, List.getElem?_map]
        rw [List.getElem?_eq_getElem (by scalar_tac)]; rfl
      rw [a_post, bytesOf_set_getElem?, out3_post, bytesOf_set_getElem?, out2_post,
        bytesOf_set_getElem?, out1_post, bytesOf_set_getElem?, i11_post, i9_post, i6_post, i3_post]
      by_cases hk1 : k < 4 * ii.val
      · rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), if_neg (by omega)]
        exact h2 k hk1
      · obtain ⟨b, hb, rfl⟩ : ∃ b, b < 4 ∧ k = 4 * ii.val + b := ⟨k - 4 * ii.val, by scalar_tac, by omega⟩
        rw [flatMap_wordBytes_getElem? _ _ _ hb, hw]
        have h32 : 4 * ii.val + 3 < 32 := by scalar_tac
        obtain rfl | rfl | rfl | rfl : b = 0 ∨ b = 1 ∨ b = 2 ∨ b = 3 := by omega
        · rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), if_pos ⟨by omega, by simp; omega⟩]
          simp only [Option.bind_some, Sha256.wordBytes]
          rw [i4_post, wordByte_eq state.val[ii.val] i2 24 (by decide) (by rw [i2_post1, ← i1_post]; rfl)]
          rfl
        · rw [if_neg (by omega), if_neg (by omega), if_pos ⟨by omega, by simp; omega⟩]
          simp only [Option.bind_some, Sha256.wordBytes]
          rw [i7_post, wordByte_eq state.val[ii.val] i5 16 (by decide) (by rw [i5_post1, ← i1_post]; rfl)]
          rfl
        · rw [if_neg (by omega), if_pos ⟨by omega, by simp; omega⟩]
          simp only [Option.bind_some, Sha256.wordBytes]
          rw [i10_post, wordByte_eq state.val[ii.val] i8 8 (by decide) (by rw [i8_post1, ← i1_post]; rfl)]
          rfl
        · rw [if_pos ⟨by omega, by simp; omega⟩]
          simp only [Option.bind_some, Sha256.wordBytes]
          rw [i12_post, i1_post, wordByte_eq0]
          rfl
    · simp only [WP.spec_ok]
      have he : ii.val = 8 := by scalar_tac
      rw [he] at h2
      apply List.ext_getElem?
      intro k
      by_cases hk : k < 32
      · exact h2 k hk
      · rw [List.getElem?_eq_none (by simp [bytesOf]; omega), List.getElem?_eq_none]
        rw [Sha256.flatMap_wordBytes_length]; simp [wordsOf]; omega
  · exact ⟨hi, hout⟩

theorem finalize_loop6_spec (state : Array U32 8#usize) (out : Array U8 32#usize) (i : Usize)
    (hi : i.val ≤ 8)
    (hout : ∀ k < 4 * i.val, (bytesOf out)[k]? = ((wordsOf state).flatMap Sha256.wordBytes)[k]?) :
    sha256.Sha256.finalize_loop6 state out i ⦃ r =>
      bytesOf r = (wordsOf state).flatMap Sha256.wordBytes ⦄ := by
  unfold sha256.Sha256.finalize_loop6
  apply loop.spec_decr_nat (measure := fun p => 8 - p.2.val)
    (inv := fun p => p.2.val ≤ 8 ∧
      ∀ k < 4 * p.2.val, (bytesOf p.1)[k]? = ((wordsOf state).flatMap Sha256.wordBytes)[k]?)
  · rintro ⟨o1, ii⟩ ⟨h1, h2⟩
    dsimp only at h1 h2
    unfold sha256.Sha256.finalize_loop6.body
    simp only []
    split
    · step*
      refine ⟨by scalar_tac, ?_, by scalar_tac⟩
      intro k hk
      have hii : ii.val < state.val.length := by scalar_tac
      have hw : (wordsOf state)[ii.val]? = some (toW state.val[ii.val]) := by
        simp only [wordsOf, List.getElem?_map]
        rw [List.getElem?_eq_getElem (by scalar_tac)]; rfl
      rw [a_post, bytesOf_set_getElem?, out3_post, bytesOf_set_getElem?, out2_post,
        bytesOf_set_getElem?, out1_post, bytesOf_set_getElem?, i11_post, i9_post, i6_post, i3_post]
      by_cases hk1 : k < 4 * ii.val
      · rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), if_neg (by omega)]
        exact h2 k hk1
      · obtain ⟨b, hb, rfl⟩ : ∃ b, b < 4 ∧ k = 4 * ii.val + b := ⟨k - 4 * ii.val, by scalar_tac, by omega⟩
        rw [flatMap_wordBytes_getElem? _ _ _ hb, hw]
        have h32 : 4 * ii.val + 3 < 32 := by scalar_tac
        obtain rfl | rfl | rfl | rfl : b = 0 ∨ b = 1 ∨ b = 2 ∨ b = 3 := by omega
        · rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), if_pos ⟨by omega, by simp; omega⟩]
          simp only [Option.bind_some, Sha256.wordBytes]
          rw [i4_post, wordByte_eq state.val[ii.val] i2 24 (by decide) (by rw [i2_post1, ← i1_post]; rfl)]
          rfl
        · rw [if_neg (by omega), if_neg (by omega), if_pos ⟨by omega, by simp; omega⟩]
          simp only [Option.bind_some, Sha256.wordBytes]
          rw [i7_post, wordByte_eq state.val[ii.val] i5 16 (by decide) (by rw [i5_post1, ← i1_post]; rfl)]
          rfl
        · rw [if_neg (by omega), if_pos ⟨by omega, by simp; omega⟩]
          simp only [Option.bind_some, Sha256.wordBytes]
          rw [i10_post, wordByte_eq state.val[ii.val] i8 8 (by decide) (by rw [i8_post1, ← i1_post]; rfl)]
          rfl
        · rw [if_pos ⟨by omega, by simp; omega⟩]
          simp only [Option.bind_some, Sha256.wordBytes]
          rw [i12_post, i1_post, wordByte_eq0]
          rfl
    · simp only [WP.spec_ok]
      have he : ii.val = 8 := by scalar_tac
      rw [he] at h2
      apply List.ext_getElem?
      intro k
      by_cases hk : k < 32
      · exact h2 k hk
      · rw [List.getElem?_eq_none (by simp [bytesOf]; omega), List.getElem?_eq_none]
        rw [Sha256.flatMap_wordBytes_length]; simp [wordsOf]; omega
  · exact ⟨hi, hout⟩

/-! ## finalize: the padded blocks -/

theorem tail_getElem? (P : Bytes) (z : Nat) (T : Bytes) (j : Nat) :
    (P ++ [0x80] ++ List.replicate z 0 ++ T)[j]? =
      if j < P.length then P[j]? else if j = P.length then some 0x80
      else if j < P.length + 1 + z then some 0 else T[j - (P.length + 1 + z)]? := by
  simp only [List.append_assoc, List.getElem?_append, List.length_cons, List.length_nil,
    List.length_replicate, List.getElem?_replicate]
  split_ifs <;> first | rfl | omega | (rw [show j - P.length = 0 by omega]; rfl) | (congr 1; omega)

theorem zeros_getElem? (c : Nat) (T : Bytes) (k : Nat) :
    (List.replicate c (0 : UInt8) ++ T)[k]? = if k < c then some 0 else T[k - c]? := by
  rw [List.getElem?_append]
  simp only [List.length_replicate, List.getElem?_replicate]
  split_ifs <;> rfl

theorem bytesOf_getElem?_ge {n : Usize} (a : Array U8 n) (k : Nat) (hk : n.val ≤ k) :
    (bytesOf a)[k]? = none :=
  List.getElem?_eq_none (by rw [bytesOf_length]; exact hk)

/-- The buffer after `buf[r] = 0x80` and zeros up to `B`, read against the
model's padded tail: they agree below `B`. -/
theorem padded_prefix (buf0 buf : Array U8 64#usize) (i : Usize) (B : Nat) (P T : Bytes)
    (hrB : i.val < B) (hB : B ≤ 64) (hP : (bytesOf buf0).take i.val = P)
    (hbuf : ∀ j, (bytesOf buf)[j]? =
      if i.val + 1 ≤ j ∧ j < B then some 0 else (bytesOf (buf0.set i 128#u8))[j]?) :
    ∀ j < B, (bytesOf buf)[j]? = (P ++ [0x80] ++ List.replicate (B - 1 - i.val) 0 ++ T)[j]? := by
  have hPl : P.length = i.val := by
    rw [← hP, List.length_take, bytesOf_length]; simp; omega
  intro j hj
  rw [hbuf, bytesOf_set_getElem?, tail_getElem?, hPl]
  by_cases h1 : j < i.val
  · rw [if_neg (by omega), if_neg (by omega), if_pos h1, ← hP, List.getElem?_take, if_pos h1]
  · by_cases h2 : j = i.val
    · rw [if_neg (by omega), if_pos ⟨h2.symm, by simp; omega⟩, if_neg h1, if_pos h2]; rfl
    · rw [if_pos ⟨by omega, hj⟩, if_neg h1, if_neg h2, if_pos (by omega)]

/-! ## The four contracts: finalize and the one-shot hash -/

@[step]
theorem finalize_spec (s : sha256.Sha256) (m : Bytes) (h : Absorbed s m) :
    sha256.Sha256.finalize s ⦃ r => bytesOf r = KdfStandardModel.sha256 m ⦄ := by
  obtain ⟨h1, h2, h3, h4⟩ := h
  have hlt : s.buf_len.val < 64 := by rw [h1]; omega
  unfold sha256.Sha256.finalize
  step as ⟨bit_len, hbl⟩
  have hX : bit_len.val = 8 * m.length % 2 ^ 64 := by
    have hs : UScalar.size .U64 = 2 ^ 64 := by simp [U64.size, U64.numBits]
    rw [hbl, core.num.U64.wrapping_mul_val_eq, h2, hs]; simp; omega
  step as ⟨x, back, hx, hback⟩
  step as ⟨n, hn⟩
  rw [← h1] at h4
  split
  · rename_i hgt
    have hr : 56 ≤ m.length % 64 := by scalar_tac
    step with finalize_loop0_spec (back 128#u8) n (by scalar_tac) as ⟨buf, hbuf⟩
    step with compress_spec as ⟨st1, hst1⟩
    step with finalize_loop1_spec buf 0#usize (by simp) as ⟨buf1, hbuf1⟩
    step with finalize_loop2_spec bit_len buf1 0#usize (by simp) as ⟨buf2, hbuf2⟩
    step with compress_spec as ⟨st2, hst2⟩
    step with finalize_loop3_spec st2 _ 0#usize (by simp) (by intro k hk; simp at hk) as ⟨out, hout⟩
    have hb1 : bytesOf buf = m.drop (64 * (m.length / 64)) ++ [0x80] ++
        List.replicate (63 - m.length % 64) 0 := by
      have hpp := padded_prefix s.buf buf s.buf_len 64 _ [] (by omega) (le_refl _) h4
        (by rw [hback, hn] at hbuf; exact hbuf)
      apply List.ext_getElem?
      intro j
      by_cases hj : j < 64
      · rw [hpp j hj, List.append_nil, h1]
      · rw [bytesOf_getElem?_ge _ _ (by simp; omega), List.getElem?_eq_none]
        simp; omega
    have hb2 : bytesOf buf2 = List.replicate 56 0 ++ Sha256.be64 (8 * m.length % 2 ^ 64) := by
      simp only [Nat.add_zero] at hbuf1 hbuf2
      apply List.ext_getElem?
      intro k
      rw [hbuf2, hbuf1, zeros_getElem?]
      by_cases hk : k < 56
      · rw [if_neg (show ¬(56 ≤ k ∧ k < 64) by omega), if_pos (show 0 ≤ k ∧ k < 56 by omega),
          if_pos hk]
      · by_cases hk2 : k < 64
        · rw [if_pos (show 56 ≤ k ∧ k < 64 by omega), if_neg hk, be64_getElem? _ _ (by omega), hX]
        · rw [if_neg (show ¬(56 ≤ k ∧ k < 64) by omega), if_neg (show ¬(0 ≤ k ∧ k < 56) by omega),
            if_neg hk, bytesOf_getElem?_ge _ _ (by simp; omega),
            List.getElem?_eq_none (by rw [Sha256.be64_length]; omega)]
    rw [hout, hash_long m hr, hst2, hst1, h3, hb1, hb2]
  · rename_i hle
    have hr : m.length % 64 ≤ 55 := by scalar_tac
    step with finalize_loop4_spec (back 128#u8) n (by scalar_tac) as ⟨buf, hbuf⟩
    step with finalize_loop5_spec bit_len buf 0#usize (by simp) as ⟨buf1, hbuf1⟩
    step with compress_spec as ⟨st1, hst1⟩
    step with finalize_loop6_spec st1 _ 0#usize (by simp) (by intro k hk; simp at hk) as ⟨out, hout⟩
    have hb : bytesOf buf1 = m.drop (64 * (m.length / 64)) ++ [0x80] ++
        List.replicate (55 - m.length % 64) 0 ++ Sha256.be64 (8 * m.length % 2 ^ 64) := by
      have hpp := padded_prefix s.buf buf s.buf_len 56 _ (Sha256.be64 (8 * m.length % 2 ^ 64))
        (by omega) (by omega) h4 (by rw [hback, hn] at hbuf; exact hbuf)
      simp only [Nat.add_zero] at hbuf1
      apply List.ext_getElem?
      intro k
      rw [hbuf1]
      by_cases hk : k < 56
      · rw [if_neg (show ¬(56 ≤ k ∧ k < 64) by omega), hpp k hk, h1]
      · rw [tail_getElem?, drop_blocks_length,
          if_neg (show ¬(k < m.length % 64) by omega), if_neg (show ¬(k = m.length % 64) by omega),
          if_neg (show ¬(k < m.length % 64 + 1 + (55 - m.length % 64)) by omega),
          show k - (m.length % 64 + 1 + (55 - m.length % 64)) = k - 56 by omega]
        by_cases hk2 : k < 64
        · rw [if_pos (show 56 ≤ k ∧ k < 64 by omega), be64_getElem? _ _ (by omega), hX]
        · rw [if_neg (show ¬(56 ≤ k ∧ k < 64) by omega), bytesOf_getElem?_ge _ _ (by simp; omega),
            List.getElem?_eq_none (by rw [Sha256.be64_length]; omega)]
    rw [hout, hash_short m hr, hst1, h3, hb]

@[step]
theorem sha256_spec (data : Slice U8) :
    sha256.sha256 data ⦃ r => bytesOf r = KdfStandardModel.sha256 (sliceBytes data) ⦄ := by
  unfold sha256.sha256
  step with new_spec as ⟨h, hh⟩
  step with update_spec h [] data hh as ⟨h1, hh1⟩
  step with finalize_spec h1 _ hh1 as ⟨r, hr⟩
  simpa using hr

end Tacenta.KdfProofSession
