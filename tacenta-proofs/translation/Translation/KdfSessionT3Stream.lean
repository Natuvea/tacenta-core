    rw [ht, core.num.U64.wrapping_add_val_eq, h2, hs]; simp
  have hset0 := bytesOf_set_take s.buf s.buf_len b hlt
  have hset := hset0
  rw [h1, h4] at hset
  split
  · rename_i heq
    have h63 : s.buf_len.val = 63 := by
      have : i.val = 64 := by rw [heq]; rfl
      omega
