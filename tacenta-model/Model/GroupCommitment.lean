/-
Model.GroupCommitment: the two public SHA-256 commitment helpers used by the
bounded group validation profile. Roster and application-context parsing stay
product-owned; this model binds already canonical byte preimages only.
 -/

import Model.Sha256

namespace Model.GroupCommitment

def rosterLabel : List UInt8 :=
  [0x54, 0x61, 0x63, 0x65, 0x6e, 0x74, 0x61, 0x3a, 0x67, 0x72, 0x6f, 0x75,
   0x70, 0x3a, 0x72, 0x6f, 0x73, 0x74, 0x65, 0x72, 0x2d, 0x63, 0x6f, 0x6d,
   0x6d, 0x69, 0x74, 0x6d, 0x65, 0x6e, 0x74, 0x3a, 0x76, 0x31, 0xff]

def payloadLabel : List UInt8 :=
  [0x54, 0x61, 0x63, 0x65, 0x6e, 0x74, 0x61, 0x3a, 0x67, 0x72, 0x6f, 0x75,
   0x70, 0x3a, 0x70, 0x61, 0x79, 0x6c, 0x6f, 0x61, 0x64, 0x2d, 0x63, 0x6f,
   0x6d, 0x6d, 0x69, 0x74, 0x6d, 0x65, 0x6e, 0x74, 0x3a, 0x76, 0x31, 0xff]

def rosterCommitment (preimage : List UInt8) : List UInt8 :=
  Model.Sha256.hash (rosterLabel ++ preimage)

def payloadCommitment (context : List UInt8) : List UInt8 :=
  Model.Sha256.hash (payloadLabel ++ context)

theorem rosterCommitment_length (preimage : List UInt8) :
    (rosterCommitment preimage).length = 32 := Model.Sha256.hash_length _

theorem payloadCommitment_length (context : List UInt8) :
    (payloadCommitment context).length = 32 := Model.Sha256.hash_length _

example : rosterLabel != payloadLabel := by native_decide

end Model.GroupCommitment
