{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tacenta.dev/schema/assurance-manifest.schema.json",
  "title": "Tacenta assurance manifest, version 1",
  "description": "Canonical inventory of one clean candidate's source identities, selected run receipts and pending independent review requirement. The builder and validator enforce the complete contract without relying on a JSON Schema runtime; this file states the field names they hold and the case runner checks that it agrees with them.",
  "type": "object",
  "required": ["schema_version", "identity", "sources", "checks", "review_requirements"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "identity": {
      "type": "object",
      "required": ["repository", "source_commit", "source_tree", "clean_tree", "generator", "generator_sha256"],
      "additionalProperties": false,
      "properties": {
        "repository": { "const": "Natuvea/tacenta-core" },
        "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "source_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "clean_tree": { "const": true },
        "generator": { "const": "tooling/build-assurance-manifest.py" },
        "generator_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "checks": { "type": "array", "minItems": 1 },
    "review_requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "const": { "type": "independent-ledger-review", "status": "pending" } }
    }
  }
}
